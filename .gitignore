# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Next.js build artifacts
frontend/.next/
frontend/out/

# TypeScript build outputs
backend/dist/
*.tsbuildinfo

# Environment variables (NEVER commit secrets!)
.env
.env.local
backend/.env
frontend/.env.local

# Allow example environment files to be committed
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS generated files
.DS_Store
Thumbs.db

# IDE configuration
.idea/
.vscode/
